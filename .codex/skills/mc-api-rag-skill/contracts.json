{
  "artifacts": {
    "normalizedMap": "mc-normalized-api-map.json",
    "semanticChunks": "mc-llm-api-chunks.json"
  },
  "preferredWorkflow": [
    "semantic_discovery_if_fuzzy",
    "deterministic_lookup_for_exactness",
    "schema_followup_if_needed"
  ],
  "recommendedHelpers": [
    "findOperations",
    "getOperationById",
    "getOperationByMethodAndPath",
    "getSchema",
